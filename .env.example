# Set your real HTTPS origin before building or deploying (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: own/licensed instrumental file placed in public/audio or HTTPS URL.
# Sound starts only when a guest presses Play.
NEXT_PUBLIC_AUDIO_URL=
# Server-only Apple Developer credentials. Never prefix these with NEXT_PUBLIC_.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_WWDR_CERT_BASE64=
APPLE_SIGNER_CERT_BASE64=
APPLE_SIGNER_KEY_BASE64=
APPLE_SIGNER_KEY_PASSPHRASE=
